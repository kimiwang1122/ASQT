# Weekdays 20:05 — fallback after in-process 16:30 / 18:00.
# crontab does not expand shell variables; keep absolute paths.
# Machine TZ should be Asia/Shanghai (or wrap the command with TZ=Asia/Shanghai).

5 20 * * 1-5 /Users/kimi/Documents/ChatGPT/ASQT/scripts/asqt-cron-fallback.sh >> /Users/kimi/Documents/ChatGPT/ASQT/data/logs/cron-fallback.log 2>&1

# Weekdays 19:15 — cross-source reconcile (after sync window, before 20:05 fallback).
# auto peer prefers Tushare when token exists; job/peer timeouts fail + Feishu alert.
# In-process API also runs this when ASQT_RECONCILE_AUTO=1; cron is the out-of-process backup.
15 19 * * 1-5 /Users/kimi/Documents/ChatGPT/ASQT/.venv/bin/asqt reconcile --universe --lookback-days 14 --peer auto >> /Users/kimi/Documents/ChatGPT/ASQT/data/logs/reconcile.cron.log 2>&1

# Weekdays 19:45 — paper cash reconcile (after cross-source, before 20:05 fallback).
# Checks fill→cash/qty, portfolio share funding, and combined NAV (not N× full cash).
# In-process API also runs this when ASQT_CASH_RECONCILE_AUTO=1; cron is the out-of-process backup.
45 19 * * 1-5 /Users/kimi/Documents/ChatGPT/ASQT/.venv/bin/asqt cash-reconcile >> /Users/kimi/Documents/ChatGPT/ASQT/data/logs/cash-reconcile.cron.log 2>&1
